# Database (Supabase Connection Pooler)
DATABASE_URL=postgresql://postgres.user:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase S3 Storage (Offloads JSON to stay within 500MB DB tier)
S3_ENDPOINT=https://user.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=storage

# LLM Provider Keys (Primary & Fallback Cascade)
GEMINI_API_KEY=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here

# Model Configuration
LLM_PROVIDER=gemini
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_HEAVY=gemini-3.6-flash
GEMINI_MODEL_FALLBACK_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK_HEAVY=gemini-3.5-flash

# Active Core Models
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.6-flash

# Embedding and Reranker
# Demo Tier (Local CPU / Fast Evaluation): BAAI/bge-small-en-v1.5 (384-dim) & BAAI/bge-reranker-base (~440MB, fast CPU)
# Prod Tier (GPU Cloud / Multi-Lingual):   BAAI/bge-m3 (1024-dim) & BAAI/bge-reranker-v2-m3 (2.27GB, GPU-accelerated)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_ENABLED=true

# Reliability & Abstention Thresholds
ABSTAIN_THRESHOLD=0.25
RERANKER_FLOOR=0.15
RRF_FLOOR=0.005

# Silent Failure Controls & Limits
LLM_TIMEOUT_SECONDS=25.0
CONTEXT_TOKEN_LIMIT=6000
LOG_LEVEL=INFO

# Cost Tracking Thresholds (USD)
GEMINI_INPUT_COST_PER_1K=0.000075
GEMINI_OUTPUT_COST_PER_1K=0.000300
LLM_COST_WARN_THRESHOLD_USD=0.01

# Frontend / Server
PORT=7860
FRONTEND_URL=http://localhost:5173

# HuggingFace Cache (Optional: Redirect to project directory due to C: drive space constraints)
HF_HOME=D:\Academic\mavenir_chatbot

# Fix PyTorch/TensorFlow Thread Pool Deadlocks on Windows CPU
KMP_DUPLICATE_LIB_OK=TRUE
